##### UNITY PROJECT IGNORE RULES #####

# Unity generated folders (never commit these)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Addressables
[Aa]ssets/AddressableAssetsData/*/*.bin*
[Aa]ssets/AddressableAssetsData/*/*.crc
[Aa]ssets/AddressableAssetsData/link.xml

# Cache
sysinfo.txt

# Unity auto-generated files
*.pidb
*.suo
*.user
*.userprefs
*.csproj
*.unityproj
*.sln
*.svd
*.pdb
*.mdb
.vs/


# OS generated
.DS_Store
Thumbs.db

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# TextMeshPro generated files
[Aa]ssets/TextMesh Pro/**/Resources/Fonts & Materials/*.asset

# Plastic SCM
*.plastic
.plastic/

# ShaderCache (if HDRP/URP)
[Aa]ssets/**/ShaderCache/

# Collaborate (deprecated backend)
[Aa]ssets/**/Collab/**

